{
  "compilerOptions": {
    "target": "es2020",
    "lib": [ "es2020" ],
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "baseUrl": "./node_modules",
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "./node_modules",
    "**/*.spec.ts"
  ]
}